# Valores privados: el programa lee .env.local y variables de entorno.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Opcional: sintetizar voz con el proveedor indicado en agents/05-voz.md.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# OAuth Desktop de Google. El archivo y los tokens quedan fuera de Git.
YOUTUBE_CLIENT_FILE=credentials/youtube-client.json
# Obligatorio para publicar: ID exacto del canal autorizado.
YOUTUBE_CHANNEL_ID=
# Instagram actual: login de Composio CLI; no requiere pegar tokens aquí.
# Estas variables se conservan solo para reconciliar registros del adaptador histórico.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Elegí una versión admitida por tu aplicación de Meta (por ejemplo v24.0).
INSTAGRAM_API_VERSION=
# Opcional: aprobación en Telegram. Solo se acepta este usuario en este chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
